{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./out-tsc/spec",
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "ES2020",
    "types": [],
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "sourceMap": false,
    "declaration": false,
    "resolveJsonModule": true
  },
  "include": [
    "src/**/*.spec.ts",
    "src/testing/**/*.ts",
    "tests/**/*.ts"
  ]
}
